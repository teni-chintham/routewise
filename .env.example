# Copy to .env (never committed). Keys are only needed for the cloud models you enable in models.yaml.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional settings
ASSISTANT_EMBEDDER=ollama            # ollama | tfidf  (both run locally)
OLLAMA_HOST=http://localhost:11434
# ASSISTANT_HOME=~/.context-assistant   # where memory, scorecards, ledger and egress log live
# ASSISTANT_COST_BUDGET=0.002           # C_max, USD per query
# ASSISTANT_LATENCY_BUDGET=30           # L_max, seconds
# ASSISTANT_PRIVATE_CONTEXT=local       # local | allow
# ASSISTANT_FIXED_MODEL=llama3.2-3b
